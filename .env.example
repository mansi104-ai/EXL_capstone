# ---- GuardianCX configuration ----
# Copy to .env and fill in what you have. Everything is optional: unset
# integrations fall back to safe local implementations so the app still runs.

# --- LLM provider ---
# Option A: Anthropic / Claude directly
ANTHROPIC_API_KEY=
GUARDIANCX_CLAUDE_MODEL=claude-opus-5
# Option B: OpenRouter (OpenAI-compatible; used only if ANTHROPIC_API_KEY is empty).
# Pick any model slug from https://openrouter.ai/models — e.g. a Claude, GPT, or
# open model. Examples: anthropic/claude-sonnet-4.5, openai/gpt-4o-mini,
# google/gemini-2.0-flash-001, meta-llama/llama-3.1-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Azure OpenAI embeddings ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Azure Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Database ---
# Leave unset to use a local SQLite file (artifacts/guardiancx.db).
# Example Postgres URL: postgresql+psycopg2://user:pass@localhost:5432/guardiancx
GUARDIANCX_DATABASE_URL=

# --- Vector DB (ChromaDB) ---
GUARDIANCX_CHROMA_DIR=artifacts/chroma

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MLFLOW_TRACKING_URI=

# --- Guardrail thresholds ---
GUARDIANCX_CONFIDENCE_THRESHOLD=0.55
GUARDIANCX_HIGH_RISK_APPROVAL=1
