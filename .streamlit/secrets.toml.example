# GuardianCX — Streamlit secrets template
#
# HOW TO USE
#  • Streamlit Community Cloud: open your app → ⋮ → Settings → Secrets, and paste
#    the keys you need (top-level, exactly as named below). The app reads them via
#    st.secrets and works immediately — no .env required.
#  • Local dev: either use a .env file (see .env.example) OR copy this file to
#    .streamlit/secrets.toml and fill it in. Never commit the real secrets.toml.
#
# Names must match exactly (they map 1:1 to the app's settings). Leave a key out
# entirely to use that integration's graceful fallback.

# --- LLM provider (pick ONE) ---
# Option A: Anthropic / Claude
ANTHROPIC_API_KEY = ""
GUARDIANCX_CLAUDE_MODEL = "claude-opus-5"
# Option B: OpenRouter (used only when ANTHROPIC_API_KEY is empty)
OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "anthropic/claude-sonnet-4.5"

# --- Azure Speech (the live call: continuous recognition + the spoken reply) ---
# Without these the call falls back to the browser's own recogniser (Chrome or
# Edge only) and the handler's reply is text rather than speech.
AZURE_SPEECH_KEY = ""
AZURE_SPEECH_REGION = "eastus"

# --- Azure OpenAI embeddings (optional; else local sentence-transformers) ---
AZURE_OPENAI_API_KEY = ""
AZURE_OPENAI_ENDPOINT = ""
AZURE_OPENAI_EMBEDDING_DEPLOYMENT = "text-embedding-3-small"
AZURE_OPENAI_API_VERSION = "2024-06-01"

# --- Database (optional; else local SQLite) ---
GUARDIANCX_DATABASE_URL = ""

# --- Guardrail tuning (optional) ---
GUARDIANCX_CONFIDENCE_THRESHOLD = "0.55"
GUARDIANCX_HIGH_RISK_APPROVAL = "1"
